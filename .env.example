# ==============================================================================
# IronChat Configuration Template (.env.example)
# Copy this file to .env and adjust the values for your private deployment:
#   cp .env.example .env
# ==============================================================================

# ----------------- 1. Core User Whitelist (Strict Two-Party) -----------------
# 核心双人白名单：定义系统允许且仅允许的两名用户（其余用户名均会被系统直接拒绝访问）
USER_A=alice
USER_B=bob

# ----------------- 2. Security Timers & Thresholds -----------------
# TOTP 动态码刷新步长（秒）：
# ⚠️ 关键兼容性警示 (CRITICAL COMPATIBILITY NOTICE):
# - 强烈推荐保持默认的 30 秒 (Standard RFC 6238)。
# - 所有主流 Authenticator 应用（Google Authenticator、苹果自带密码钥匙串、1Password、
#   Bitwarden、Microsoft Authenticator、2FAS 等）均原生支持 30 秒。
# - 注意：Google Authenticator 客户端在扫码时会直接忽略 otpauth 链接里的 period=60 参数，
#   强制按 30 秒计算，导致若设置为 60s 时 Google Authenticator 必定验证失败！
# - 仅当双方均使用显式支持自定义周期的客户端（如 1Password、KeePassXC、2FAS）时才可调整为 60。
TOTP_INTERVAL=30

# 用户无交互自动登出超时（秒，默认 24 小时 = 86400）
SESSION_INACTIVITY_TIMEOUT=86400

# 48 小时死人开关超时（秒，默认 48 小时 = 172800）
# 若整套系统连续 48 小时无任何用户访问或交互，后台守护程序将自动物理粉碎所有数据并重置系统！
DEAD_MAN_TIMEOUT=172800

# 消息滚动留存上限（秒，默认 7 天 = 604800）
# 即使标记为永久保存的消息，满 7 天后后台守护程序也会自动物理粉碎，确保数据轻量与磁盘整洁
MESSAGE_RETENTION_SECONDS=604800

# ----------------- 3. Security Credentials & Cryptography -----------------
# 提示：以下安全密钥均支持【留空】！
# 若留空，容器在首次启动时会自动生成密码学安全的强随机密钥并保存在 data/state.json 中，开箱即用。

# HTTP 会话签名私钥（留空将自动生成 64 位安全随机密钥并持久化保存）
SECRET_KEY=

# 端对端加密主口令种子（留空将自动生成 32 位高强度安全随机密钥并持久化保存）
E2EE_MASTER_PASSPHRASE=

# WebCrypto PBKDF2 派生密钥盐值（留空将自动生成并持久化保存）
E2EE_SALT=

# ----------------- 4. Domain & Web Push (VAPID) Settings -----------------
# 访问域名（例如 chat.example.com 或内网 IP）
APP_DOMAIN=chat.example.com

# Web Push RFC 8292 声明邮箱（用于合规标识，零敏感信息）
VAPID_CLAIM_EMAIL=admin@example.com

# ----------------- 5. Network & Port -----------------
PORT=8088
HOST=0.0.0.0
DATA_DIR=/app/data
