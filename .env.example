# ==============================================================================
#                 🔒 IronChat Configuration Reference Template
#                           项目环境变量完整配置字典
# ==============================================================================
# Copy this file to .env before starting the container:
#   cp .env.example .env
#
# NOTE: All security secrets (SECRET_KEY, E2EE_MASTER_PASSPHRASE, E2EE_SALT)
# can be left completely BLANK. When left empty, IronChat will automatically
# generate cryptographically secure high-entropy random keys on first startup
# and persist them inside data/state.json.
# ==============================================================================

# ==============================================================================
# 1. CORE USER WHITELIST (严格双人白名单)
# ==============================================================================

# [USER_A]
# EN: The username of the first allowed user. Case-sensitive.
# ZH: 第一位合法用户的用户名。区分大小写。
# Type: String | Required: Yes | Example: alice
# Mechanism: IronChat strictly allows only two users. Any registration or login
# attempt using a username other than USER_A or USER_B is denied at the protocol level.
USER_A=alice

# [USER_B]
# EN: The username of the second allowed user. Case-sensitive.
# ZH: 第二位合法用户的用户名。区分大小写。
# Type: String | Required: Yes | Example: bob
# Mechanism: The chat peer for USER_A. Only USER_A and USER_B can establish sessions.
USER_B=bob


# ==============================================================================
# 2. SECURITY TIMERS & THRESHOLDS (安全时间周期与自毁阈值)
# ==============================================================================

# [TOTP_INTERVAL]
# EN: Time step in seconds for RFC 6238 TOTP dynamic code generation.
# ZH: TOTP 双因子动态验证码的刷新步长（秒）。
# Type: Integer | Required: No | Default: 30 | Allowed: 30 or 60
# ⚠️ CRITICAL COMPATIBILITY NOTICE / 关键兼容性警示:
# - Standard 30 seconds (DEFAULT & RECOMMENDED): Universal compatibility with ALL
#   authenticator apps (Google Authenticator, Apple Passwords Keychain, 1Password,
#   Bitwarden, Microsoft Authenticator, 2FAS, YubiKey, Authy).
# - 60 seconds limitation: Google Authenticator (iOS & Android) COMPLETELY IGNORES
#   the 'period=60' parameter in QR code URLs and forces a 30-second window, which
#   will cause continuous code verification failures!
# - Only change this to 60 if BOTH users strictly use apps with custom period support
#   (such as 1Password, KeePassXC, or 2FAS).
TOTP_INTERVAL=30

# [SESSION_INACTIVITY_TIMEOUT]
# EN: Inactivity timeout in seconds before a user session is invalidated.
# ZH: 单用户会话无交互自动登出超时（秒）。
# Type: Integer | Required: No | Default: 86400 (24 hours)
# Mechanism: If a logged-in user does not visit the app, send a message, or ping
# via WebSocket for this duration, their session cookie expires immediately.
# Re-entering the app requires dynamic password verification (username@TOTP).
SESSION_INACTIVITY_TIMEOUT=86400

# [DEAD_MAN_TIMEOUT]
# EN: Global Dead Man's Switch timeout in seconds.
# ZH: 全局死人开关超时阈值（秒）。
# Type: Integer | Required: No | Default: 172800 (48 hours)
# Mechanism: Tracks the system-wide latest interaction across BOTH users. If 48 hours
# pass without ANY activity (no messages, no API calls, no active WebSocket connections),
# the backend assumes the instance has been abandoned or compromised. It automatically
# triggers a full physical shredding of all databases, files, and TOTP secrets,
# resetting the container into a fresh factory unactivated state!
DEAD_MAN_TIMEOUT=172800

# [MESSAGE_RETENTION_SECONDS]
# EN: Rolling retention threshold for chat messages and attachments in seconds.
# ZH: 消息与附件滚动保留上限（秒）。
# Type: Integer | Required: No | Default: 604800 (7 days)
# Mechanism: Even if a message is sent with burn_mode='never' (permanent), its maximum
# lifetime is strictly capped at 7 days. A background daemon scans every 60 seconds
# and physically overwrites and deletes messages and files older than this limit.
# This prevents database bloat and guarantees that initial sync payloads stay under 200KB.
MESSAGE_RETENTION_SECONDS=604800


# ==============================================================================
# 3. CRYPTOGRAPHIC SECRETS (加密密钥与口令种子)
# ==============================================================================
# TIP: All 3 variables below support being left BLANK!
# 提示：以下 3 个安全密钥均支持直接【留空】！首次启动时会自动生成并固化。

# [SECRET_KEY]
# EN: Secret key used to sign HTTP session cookies using HMAC-SHA256.
# ZH: 用于签署 HTTP 会话 Cookie 的防篡改私钥。
# Type: String | Required: No (Auto-generated if empty) | Default: [Empty]
# Mechanism: Prevents cookie forgery. If left blank, IronChat generates a 64-character
# secure random hex token on first startup and persists it to data/state.json.
# If you provide one manually, use a random string of at least 32 characters.
SECRET_KEY=

# [E2EE_MASTER_PASSPHRASE]
# EN: Master passphrase seed used by clients for WebCrypto key derivation.
# ZH: 客户端 WebCrypto 端对端密钥派生的主口令种子。
# Type: String | Required: No (Auto-generated if empty) | Default: [Empty]
# Mechanism: Delivered to authenticated clients via secure session to feed into
# PBKDF2 (100,000 iterations with SHA-256) to derive the 256-bit AES-GCM hardware key.
# If left blank, IronChat generates a 32-byte URL-safe random string and saves it.
E2EE_MASTER_PASSPHRASE=

# [E2EE_SALT]
# EN: Cryptographic salt string used for PBKDF2 key derivation in the browser.
# ZH: 浏览器本地 PBKDF2 密钥派生算法使用的专属盐值（Salt）。
# Type: String | Required: No (Auto-generated if empty) | Default: [Empty]
# Mechanism: Combined with the passphrase to prevent rainbow table attacks.
# If left blank, a random 16-byte hex token is generated and persisted to data/state.json.
E2EE_SALT=


# ==============================================================================
# 4. NETWORK, DOMAIN & WEB PUSH (网络、域名与系统级推送)
# ==============================================================================

# [APP_DOMAIN]
# EN: Public or internal domain name of your IronChat instance.
# ZH: IronChat 部署的外部访问域名或内网主机名。
# Type: String | Required: No | Default: chat.example.com
# Mechanism: Used for reference in PWA manifests, links, and deployment logging.
APP_DOMAIN=chat.example.com

# [VAPID_CLAIM_EMAIL]
# EN: Administrative contact email embedded into RFC 8292 VAPID push headers.
# ZH: 嵌入到 Web Push RFC 8292 VAPID 协议声明中的管理员联系邮箱。
# Type: Email String | Required: No | Default: admin@example.com
# Mechanism: Required by Apple APNs and Google FCM push relays for contact identification.
# This email is only used in push service handshakes; no emails are actually sent.
VAPID_CLAIM_EMAIL=admin@example.com

# [PORT]
# EN: TCP port number the container application listens on internally.
# ZH: 容器内部及宿主机映射的监听网络端口。
# Type: Integer | Required: No | Default: 8088
PORT=8088

# [HOST]
# EN: Network interface binding address.
# ZH: 网络监听绑定的网卡地址。
# Type: String | Required: No | Default: 0.0.0.0 (all interfaces)
HOST=0.0.0.0

# [DATA_DIR]
# EN: Directory path inside the container where SQLite DB and files are stored.
# ZH: 容器内部存储 SQLite 数据库、状态文件与加密附件的绝对路径。
# Type: Path String | Required: No | Default: /app/data
# Mechanism: Mounted to ./data on the host machine in docker-compose.yml.
DATA_DIR=/app/data


# ==============================================================================
# 5. CLOUDFLARE TUNNEL (SCHEME 2 ONLY - 仅方案 2 使用)
# ==============================================================================

# [CLOUDFLARE_TUNNEL_TOKEN]
# EN: Cloudflare Tunnel authentication token for zero-port exposure deployments.
# ZH: 用于方案 2（Cloudflare Tunnel 零暴露部署）的隧道授权 Token。
# Type: Base64 String | Required: Only for Scheme 2 | Default: [Empty]
# Mechanism: Obtained from Cloudflare Zero Trust Dashboard (Networks -> Tunnels).
# When using 'docker compose -f deployments/docker-compose.cloudflare.yml up -d',
# the cloudflared sidecar uses this token to establish an outbound TLS tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
